###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_this_to_a_secure_random_string_in_production
APP_DEBUG=1
###< symfony/framework-bundle ###

###> doctrine/mongodb-odm-bundle ###
MONGODB_URL=mongodb://mongodb:27017/orders
MONGODB_DB=orders
###< doctrine/mongodb-odm-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
###< symfony/messenger ###

###> snc/redis-bundle ###
REDIS_URL=redis://redis:6379
###< snc/redis-bundle ###

###> external-services ###
RESTAURANT_SERVICE_URL=http://restaurant-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8080
POS_SERVICE_URL=http://pos-service:8080
###< external-services ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_in_production
###< lexik/jwt-authentication-bundle ###
