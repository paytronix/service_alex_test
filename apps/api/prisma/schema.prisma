generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  refreshTokenHash  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships       Membership[]
  auditLogs         AuditLog[]    @relation("AuditUser")

  @@map("users")
}

// ─── Organizations ───────────────────────────────────────────

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  logoUrl           String?
  timezone          String   @default("UTC")
  workingDays       Int[]    @default([1, 2, 3, 4, 5])
  shiftStartDefault String   @default("09:00")
  shiftEndDefault   String   @default("17:00")
  minRestHours      Int      @default(8)
  maxWeeklyHours    Int      @default(40)
  notifyByEmail     Boolean  @default(true)
  notifyInApp       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships       Membership[]
  departments       Department[]
  roles             Role[]
  skills            Skill[]
  employees         Employee[]
  shiftTemplates    ShiftTemplate[]
  schedules         Schedule[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@map("organizations")
}

// ─── Membership (User ↔ Organization, RBAC) ──────────────────

enum MembershipRole {
  OWNER
  MANAGER
  SUPERVISOR
  EMPLOYEE
}

model Membership {
  id             String         @id @default(uuid())
  userId         String
  organizationId String
  role           MembershipRole @default(EMPLOYEE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// ─── Invitations ─────────────────────────────────────────────

model Invitation {
  id             String         @id @default(uuid())
  email          String
  organizationId String
  role           MembershipRole @default(EMPLOYEE)
  token          String         @unique
  accepted       Boolean        @default(false)
  expiresAt      DateTime
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ─── Departments ─────────────────────────────────────────────

model Department {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([name, organizationId])
  @@map("departments")
}

// ─── Roles (job roles within org) ────────────────────────────

model Role {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]
  shiftTemplates ShiftTemplate[]

  @@unique([name, organizationId])
  @@map("roles")
}

// ─── Skills ──────────────────────────────────────────────────

model Skill {
  id             String          @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime        @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeSkills EmployeeSkill[]
  shiftTemplates ShiftTemplate[] @relation("ShiftTemplateSkills")

  @@unique([name, organizationId])
  @@map("skills")
}

// ─── Employees ───────────────────────────────────────────────

model Employee {
  id              String            @id @default(uuid())
  externalUserId  String?
  firstName       String
  lastName        String
  email           String
  phone           String?
  hireDate        DateTime?
  hourlyRate      Decimal?
  organizationId  String
  departmentId    String?
  roleId          String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?       @relation(fields: [departmentId], references: [id])
  role            Role?             @relation(fields: [roleId], references: [id])
  skills          EmployeeSkill[]
  availabilities  Availability[]
  shiftAssignments ShiftAssignment[]
  leaveRequests   LeaveRequest[]

  @@unique([email, organizationId])
  @@map("employees")
}

// ─── Employee Skills ─────────────────────────────────────────

model EmployeeSkill {
  id         String   @id @default(uuid())
  employeeId String
  skillId    String
  level      Int      @default(1)
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

// ─── Availability ────────────────────────────────────────────

model Availability {
  id         String   @id @default(uuid())
  employeeId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

// ─── Shift Templates ─────────────────────────────────────────

model ShiftTemplate {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  roleId         String?
  startTime      String
  endTime        String
  breakMinutes   Int          @default(0)
  minEmployees   Int          @default(1)
  maxEmployees   Int          @default(1)
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id])
  requiredSkills Skill[]      @relation("ShiftTemplateSkills")

  @@map("shift_templates")
}

// ─── Schedules ───────────────────────────────────────────────

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Schedule {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         ScheduleStatus   @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    ShiftAssignment[]

  @@map("schedules")
}

// ─── Shift Assignments ───────────────────────────────────────

enum ShiftAssignmentStatus {
  ASSIGNED
  CONFIRMED
  DECLINED
  SWAPPED
  NO_SHOW
  COMPLETED
}

model ShiftAssignment {
  id         String                @id @default(uuid())
  scheduleId String
  employeeId String
  date       DateTime
  startTime  String
  endTime    String
  breakMinutes Int                 @default(0)
  status     ShiftAssignmentStatus @default(ASSIGNED)
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  schedule   Schedule              @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("shift_assignments")
}

// ─── Leave Requests ──────────────────────────────────────────

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String             @id @default(uuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     LeaveRequestStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  recipientId    String
  title          String
  body           String
  type           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── Audit Log ───────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(uuid())
  userId         String?
  organizationId String?
  action         String
  entity         String
  entityId       String?
  meta           Json?
  createdAt      DateTime     @default(now())

  user           User?        @relation("AuditUser", fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}
