    "@pothos/plugin-scope-auth": "^3.21.0",
    "@pothos/plugin-validation": "^3.10.0",
    "@prisma/client": "^5.11.0",
    "@shiftflow/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "graphql": "^16.8.0",
    "graphql-scalars": "^1.22.0",
