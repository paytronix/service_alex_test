DATABASE_URL="postgresql://shiftflow:shiftflow@localhost:5432/shiftflow?schema=public"
JWT_SECRET="change-this-to-a-secure-secret"
JWT_REFRESH_SECRET="change-this-to-another-secure-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Optional Redis PubSub for GraphQL subscriptions (in-memory PubSub is used when unset)
REDIS_URL=""

# Local attachment storage directory for shift attachments
ATTACHMENT_STORAGE_DIR="storage/attachments"
