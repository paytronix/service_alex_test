generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  avatarUrl            String?
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  refreshTokenHash     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships      Membership[]
  auditLogs        AuditLog[]     @relation("AuditUser")
  employeeProfiles Employee[]
  reviewedLeaves   LeaveRequest[] @relation("LeaveReviewer")
  publishedSchedules Schedule[] @relation("SchedulePublisher")
  scheduleVersions  ScheduleVersion[] @relation("ScheduleVersionPublisher")
  notifications    Notification[]  @relation("NotificationRecipient")
  shiftChanges     ShiftAssignmentHistory[] @relation("ShiftHistoryActor")

  @@map("users")
}

// ─── Organizations ───────────────────────────────────────────

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  logoUrl           String?
  timezone          String   @default("UTC")
  workingDays       Int[]    @default([1, 2, 3, 4, 5])
  shiftStartDefault String   @default("09:00")
  shiftEndDefault   String   @default("17:00")
  minRestHours      Int      @default(8)
  maxWeeklyHours    Int      @default(40)
  notifyByEmail     Boolean  @default(true)
  notifyInApp       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships    Membership[]
  departments    Department[]
  roles          Role[]
  skills         Skill[]
  employees      Employee[]
  shiftTemplates ShiftTemplate[]
  schedules      Schedule[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  leaveRequests  LeaveRequest[]
  shiftAssignments ShiftAssignment[]
  shiftRequirements ShiftRequirement[]
  scheduleVersions ScheduleVersion[]
  shiftHistory     ShiftAssignmentHistory[]

  @@map("organizations")
}

// ─── Membership (User ↔ Organization, RBAC) ──────────────────

enum MembershipRole {
  OWNER
  MANAGER
  SUPERVISOR
  EMPLOYEE
}

model Membership {
  id             String         @id @default(uuid())
  userId         String
  organizationId String
  role           MembershipRole @default(EMPLOYEE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// ─── Invitations ─────────────────────────────────────────────

model Invitation {
  id             String         @id @default(uuid())
  email          String
  organizationId String
  role           MembershipRole @default(EMPLOYEE)
  token          String         @unique
  accepted       Boolean        @default(false)
  expiresAt      DateTime
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ─── Departments ─────────────────────────────────────────────

model Department {
  id             String   @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([name, organizationId])
  @@map("departments")
}

// ─── Roles (job roles within org) ────────────────────────────

model Role {
  id             String   @id @default(uuid())
  name           String
  description    String?
  color          String   @default("#3B82F6")
  maxLoad        Int?
  hourlyRate     Decimal?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]
  shiftTemplates ShiftTemplate[]
  shiftAssignments ShiftAssignment[]
  shiftRequirements ShiftRequirement[]

  @@unique([name, organizationId])
  @@map("roles")
}

// ─── Skills ──────────────────────────────────────────────────

model Skill {
  id             String   @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeSkills EmployeeSkill[]
  shiftTemplates ShiftTemplate[] @relation("ShiftTemplateSkills")

  @@unique([name, organizationId])
  @@map("skills")
}

// ─── Employees ───────────────────────────────────────────────

enum EmployeeStatus {
  WORKING
  VACATION
  SICK
  DISMISSED
}

model Employee {
  id                   String         @id @default(uuid())
  userId               String?
  firstName            String
  lastName             String
  email                String
  phone                String?
  photoUrl             String?
  hireDate             DateTime?
  hourlyRate           Decimal?
  status               EmployeeStatus @default(WORKING)
  maxHoursPerWeek      Int?
  maxConsecutiveShifts Int?
  minRestHours         Int?
  organizationId       String
  departmentId         String?
  roleId               String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  department       Department?       @relation(fields: [departmentId], references: [id])
  role             Role?             @relation(fields: [roleId], references: [id])
  skills           EmployeeSkill[]
  availabilities   Availability[]
  shiftAssignments ShiftAssignment[]
  leaveRequests    LeaveRequest[]

  @@unique([email, organizationId])
  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@map("employees")
}

// ─── Employee Skills ─────────────────────────────────────────

model EmployeeSkill {
  id         String   @id @default(uuid())
  employeeId String
  skillId    String
  level      Int      @default(1)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

// ─── Availability ────────────────────────────────────────────

enum AvailabilityType {
  UNAVAILABLE
  AVAILABLE
  AVAILABLE_AFTER
}

model Availability {
  id            String           @id @default(uuid())
  employeeId    String
  dayOfWeek     Int
  type          AvailabilityType @default(AVAILABLE)
  availableFrom String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@map("availabilities")
}

// ─── Shift Templates ─────────────────────────────────────────

model ShiftTemplate {
  id              String   @id @default(uuid())
  name            String
  organizationId  String
  roleId          String?
  startTime       String
  endTime         String
  crossesMidnight Boolean  @default(false)
  breakMinutes    Int      @default(0)
  minEmployees    Int      @default(1)
  maxEmployees    Int      @default(1)
  color           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id])
  requiredSkills Skill[]      @relation("ShiftTemplateSkills")
  assignments    ShiftAssignment[]
  requirements   ShiftRequirement[]

  @@unique([name, organizationId])
  @@map("shift_templates")
}

// ─── Schedules ───────────────────────────────────────────────

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Schedule {
  id             String         @id @default(uuid())
  organizationId String
  weekStartDate  DateTime       @db.Date
  status         ScheduleStatus @default(DRAFT)
  version        Int            @default(0)
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  ShiftAssignment[]
  requirements ShiftRequirement[]
  versions     ScheduleVersion[]
  history      ShiftAssignmentHistory[]
  publishedBy  User?            @relation("SchedulePublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, weekStartDate])
  @@index([organizationId, status])
  @@map("schedules")
}

// ─── Shift Assignments ───────────────────────────────────────

enum ShiftAssignmentStatus {
  ASSIGNED
  CONFIRMED
  DECLINED
  SWAPPED
  NO_SHOW
  COMPLETED
}

model ShiftAssignment {
  id              String                @id @default(uuid())
  scheduleId      String
  organizationId  String
  employeeId      String
  shiftTemplateId String
  roleId          String?
  date            DateTime
  startTime       String?
  endTime         String?
  breakMinutes    Int                   @default(0)
  status          ShiftAssignmentStatus @default(ASSIGNED)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  schedule      Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id])
  role          Role?         @relation(fields: [roleId], references: [id])

  @@index([scheduleId])
  @@index([employeeId, date])
  @@index([organizationId])
  @@index([organizationId, date])
  @@map("shift_assignments")
}

model ShiftRequirement {
  id              String   @id @default(uuid())
  organizationId  String
  scheduleId      String
  date            DateTime @db.Date
  shiftTemplateId String
  roleId          String
  requiredCount   Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule      Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])

  @@unique([scheduleId, date, shiftTemplateId, roleId])
  @@index([organizationId, date])
  @@index([scheduleId])
  @@map("shift_requirements")
}

model ScheduleVersion {
  id             String   @id @default(uuid())
  organizationId String
  scheduleId     String
  version        Int
  publishedAt    DateTime @default(now())
  publishedById  String?
  snapshot       Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule     Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  publishedBy  User?        @relation("ScheduleVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([scheduleId, version])
  @@map("schedule_versions")
}

// ─── Leave Requests ──────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  VACATION
  DAY_OFF
  SICK
  UNPAID
  OTHER
}

model LeaveRequest {
  id             String      @id @default(uuid())
  employeeId     String
  organizationId String
  type           LeaveType   @default(VACATION)
  startDate      DateTime
  endDate        DateTime
  reason         String?
  status         LeaveStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId, startDate])
  @@map("leave_requests")
}

// ─── Schedule change history ─────────────────────────────────

enum ScheduleChangeType {
  CREATED
  MOVED
  REPLACED
  REMOVED
}

model ShiftAssignmentHistory {
  id                 String             @id @default(uuid())
  organizationId     String
  scheduleId         String
  assignmentId       String
  changeType         ScheduleChangeType
  date               DateTime           @db.Date
  previousEmployeeId String?
  newEmployeeId      String?
  changedById        String?
  metadata           Json?
  changedAt          DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule     Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation("ShiftHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([scheduleId, changedAt])
  @@index([organizationId])
  @@map("shift_assignment_history")
}

// ─── Notifications ───────────────────────────────────────────

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_CHANGED
  REQUEST_APPROVED
  REQUEST_REJECTED
  SCHEDULE_PUBLISHED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model Notification {
  id             String              @id @default(uuid())
  organizationId String
  recipientId    String
  type           NotificationType
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(PENDING)
  title          String
  body           String
  payload        Json?
  attempts       Int                 @default(0)
  lastError      String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, organizationId, createdAt])
  @@index([organizationId, status])
  @@map("notifications")
}

// ─── Audit Log ───────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  organizationId String?
  action         String
  entity         String
  entityId       String?
  meta           Json?
  createdAt      DateTime @default(now())

  user         User?         @relation("AuditUser", fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([entity, entityId])
  @@map("audit_logs")
}
