    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
