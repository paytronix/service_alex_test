# PostgreSQL
POSTGRES_USER=shiftflow
POSTGRES_PASSWORD=shiftflow
POSTGRES_DB=shiftflow

# API
DATABASE_URL=postgresql://shiftflow:shiftflow@localhost:5432/shiftflow?schema=public
JWT_SECRET=change-this-to-a-secure-secret
JWT_REFRESH_SECRET=change-this-to-another-secure-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Public URLs used for generated links (iCal feeds, Stripe redirects)
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:5173

# Attachments / employee documents
ATTACHMENT_STORAGE_DIR=

# Realtime / queue (optional, falls back to in-memory PubSub)
REDIS_URL=

# Background jobs (certification statuses, webhook retries)
SCHEDULER_ENABLED=true
CERTIFICATION_REFRESH_INTERVAL_SECONDS=3600
WEBHOOK_RETRY_INTERVAL_SECONDS=60
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=10000

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Chat integrations (fallbacks when no organization connection is configured)
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# Web
VITE_API_URL=http://localhost:4000/graphql
VITE_WS_URL=ws://localhost:4000/graphql
